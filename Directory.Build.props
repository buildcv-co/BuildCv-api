<Project>

  <!--
    Ajustes compartidos por TODOS los proyectos del backend.
    Calidad como señal de portafolio (constitución, Art. VI):
    nullable estricto, C# más reciente y advertencias tratadas como errores.
  -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
